{
  "name": "twenty-meta-lead-sync",
  "version": "0.2.0-beta.6",
  "private": false,
  "description": "Sync Meta Lead Ads into Twenty CRM People with per-workspace settings, field mapping and deduplication",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "keywords": [
    "twenty-app",
    "meta-leads",
    "crm",
    "twenty"
  ],
  "engines": {
    "node": "^24.5.0",
    "yarn": "^4.0.2",
    "twenty": ">=2.50.0 <2.51.0"
  },
  "scripts": {
    "twenty": "twenty",
    "build": "twenty dev:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --experimental-loader ./tests/fixtures/sdk-loader.mjs --test tests/*.test.mjs",
    "check": "yarn typecheck && yarn test && yarn build",
    "release:check": "node scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "twenty-client-sdk": "2.50.0",
    "twenty-sdk": "2.50.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikiguillamon/twenty-meta-lead-sync.git"
  },
  "homepage": "https://github.com/mikiguillamon/twenty-meta-lead-sync#readme",
  "bugs": {
    "url": "https://github.com/mikiguillamon/twenty-meta-lead-sync/issues"
