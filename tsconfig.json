{
 "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"], "resolveJsonModule": true,
    "types": ["node", "react", "react-dom"], "baseUrl": ".",
    "paths": {"src/*": ["src/*"]}
 },
 "include": ["src/**/*.ts", "src/**/*.tsx"]
}
